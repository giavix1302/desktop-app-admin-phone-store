<UserControl x:Class="AdminPhoneStore.Views.Pages.ReviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="clr-namespace:AdminPhoneStore.Helpers"
    mc:Ignorable="d"
    d:DesignHeight="600" d:DesignWidth="1400">
    <UserControl.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <helpers:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- HEADER: Title + Stats -->
        <Border Grid.Row="0"
            Background="White"
            Padding="20"
            Margin="0,0,0,16"
            CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Color="#40000000" Opacity="0.1" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Title row -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Quản lý Reviews" FontSize="22" FontWeight="Bold" Foreground="#1E293B" />
                        <TextBlock Text="{Binding TotalItems, StringFormat='Tổng: {0} reviews'}"
                            FontSize="13" Foreground="#64748B" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1"
                        Content="🔄 Tải lại"
                        Command="{Binding LoadReviewsCommand}"
                        Background="#685AFF"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="16,10"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#5649E0" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <!-- Stats cards -->
                <Grid Grid.Row="1" Visibility="{Binding ReviewStats, Converter={StaticResource NullToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Tổng reviews -->
                    <Border Grid.Column="0" Background="#F0F4FF" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="📝" FontSize="20" />
                            <TextBlock Text="{Binding ReviewStats.TotalReviews}"
                                FontSize="22" FontWeight="Bold" Foreground="#1E293B" Margin="0,4,0,0" />
                            <TextBlock Text="Tổng reviews" FontSize="11" Foreground="#64748B" />
                        </StackPanel>
                    </Border>

                    <!-- Điểm TB -->
                    <Border Grid.Column="1" Background="#FFF7ED" CornerRadius="8" Padding="16" Margin="4,0,4,0">
                        <StackPanel>
                            <TextBlock Text="⭐" FontSize="20" />
                            <TextBlock Text="{Binding ReviewStats.AverageRating, StringFormat='{}{0:F2}'}"
                                FontSize="22" FontWeight="Bold" Foreground="#1E293B" Margin="0,4,0,0" />
                            <TextBlock Text="Điểm trung bình" FontSize="11" Foreground="#64748B" />
                        </StackPanel>
                    </Border>

                    <!-- Hôm nay -->
                    <Border Grid.Column="2" Background="#F0FDF4" CornerRadius="8" Padding="16" Margin="4,0,4,0">
                        <StackPanel>
                            <TextBlock Text="📅" FontSize="20" />
                            <TextBlock Text="{Binding ReviewStats.ReviewsToday}"
                                FontSize="22" FontWeight="Bold" Foreground="#1E293B" Margin="0,4,0,0" />
                            <TextBlock Text="Hôm nay" FontSize="11" Foreground="#64748B" />
                        </StackPanel>
                    </Border>

                    <!-- Tuần này -->
                    <Border Grid.Column="3" Background="#FFF0F0" CornerRadius="8" Padding="16" Margin="4,0,4,0">
                        <StackPanel>
                            <TextBlock Text="📆" FontSize="20" />
                            <TextBlock Text="{Binding ReviewStats.ReviewsThisWeek}"
                                FontSize="22" FontWeight="Bold" Foreground="#1E293B" Margin="0,4,0,0" />
                            <TextBlock Text="Tuần này" FontSize="11" Foreground="#64748B" />
                        </StackPanel>
                    </Border>

                    <!-- Tháng này -->
                    <Border Grid.Column="4" Background="#F5F0FF" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="🗓️" FontSize="20" />
                            <TextBlock Text="{Binding ReviewStats.ReviewsThisMonth}"
                                FontSize="22" FontWeight="Bold" Foreground="#1E293B" Margin="0,4,0,0" />
                            <TextBlock Text="Tháng này" FontSize="11" Foreground="#64748B" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- BODY -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: Filter + List -->
            <Grid Grid.Column="0" Margin="0,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Filter Panel -->
                <Border Grid.Row="0"
                    Background="White"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Color="#40000000" Opacity="0.08" />
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Product ID -->
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Product ID" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" />
                            <Border Background="#F8FAFC" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10,8">
                                <TextBox Text="{Binding FilterProductId, UpdateSourceTrigger=PropertyChanged}"
                                    Background="Transparent" BorderThickness="0"
                                    FontSize="13" Foreground="#1E293B" />
                            </Border>
                        </StackPanel>

                        <!-- User ID -->
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="User ID" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" />
                            <Border Background="#F8FAFC" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10,8">
                                <TextBox Text="{Binding FilterUserId, UpdateSourceTrigger=PropertyChanged}"
                                    Background="Transparent" BorderThickness="0"
                                    FontSize="13" Foreground="#1E293B" />
                            </Border>
                        </StackPanel>

                        <!-- Rating -->
                        <StackPanel Grid.Column="2" Margin="0,0,8,0">
                            <TextBlock Text="Rating" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" />
                            <Border Background="#F8FAFC" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Padding="4,2">
                                <ComboBox ItemsSource="{Binding RatingOptions}"
                                    SelectedItem="{Binding SelectedRating}"
                                    Background="Transparent" BorderThickness="0"
                                    FontSize="13">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                                <Setter Property="Text" Value="Tất cả" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Border>
                        </StackPanel>

                        <!-- Sort By -->
                        <StackPanel Grid.Column="3" Margin="0,0,8,0">
                            <TextBlock Text="Sắp xếp" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" />
                            <Border Background="#F8FAFC" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Padding="4,2">
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox ItemsSource="{Binding SortByOptions}"
                                        SelectedItem="{Binding SortBy}"
                                        Background="Transparent" BorderThickness="0"
                                        FontSize="13" Width="100" />
                                    <ComboBox ItemsSource="{Binding SortDirOptions}"
                                        SelectedItem="{Binding SortDir}"
                                        Background="Transparent" BorderThickness="0"
                                        FontSize="13" Width="60" Margin="4,0,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Apply Button -->
                        <Button Grid.Column="4"
                            Content="Lọc"
                            Command="{Binding ApplyFiltersCommand}"
                            Background="#685AFF"
                            Foreground="White"
                            BorderThickness="0"
                            Padding="16,0"
                            Margin="0,0,8,0"
                            Height="36"
                            FontSize="13"
                            Cursor="Hand"
                            VerticalAlignment="Bottom">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#5649E0" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Clear Button -->
                        <Button Grid.Column="5"
                            Content="Xóa lọc"
                            Command="{Binding ClearFiltersCommand}"
                            Background="#F1F5F9"
                            Foreground="#475569"
                            BorderThickness="0"
                            Padding="16,0"
                            Height="36"
                            FontSize="13"
                            Cursor="Hand"
                            VerticalAlignment="Bottom">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E2E8F0" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>

                <!-- Reviews DataGrid -->
                <Border Grid.Row="1"
                    Background="White"
                    CornerRadius="8">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Color="#40000000" Opacity="0.08" />
                    </Border.Effect>
                    <Grid>
                        <!-- Loading overlay -->
                        <Border Background="#80FFFFFF" CornerRadius="8"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                            Panel.ZIndex="10">
                            <TextBlock Text="Đang tải..." FontSize="16" Foreground="#685AFF"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <DataGrid ItemsSource="{Binding Reviews}"
                            SelectedItem="{Binding SelectedReview}"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            IsReadOnly="True"
                            SelectionMode="Single"
                            GridLinesVisibility="Horizontal"
                            HorizontalGridLinesBrush="#F1F5F9"
                            Background="Transparent"
                            BorderThickness="0"
                            RowBackground="White"
                            AlternatingRowBackground="#FAFBFC"
                            ColumnHeaderHeight="44"
                            RowHeight="48">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F8FAFC" />
                                    <Setter Property="Foreground" Value="#475569" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Padding" Value="16,0" />
                                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#EEF2FF" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F8FAFC" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Padding" Value="16,0" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Foreground" Value="#475569" />
                                            <Setter Property="FontSize" Value="13" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Người dùng" Binding="{Binding UserName}" Width="150">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Padding" Value="16,0" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Foreground" Value="#1E293B" />
                                            <Setter Property="FontSize" Value="13" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Email" Binding="{Binding UserEmail}" Width="180">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Padding" Value="16,0" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Foreground" Value="#64748B" />
                                            <Setter Property="FontSize" Value="12" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Sản phẩm" Binding="{Binding ProductName}" Width="200">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Padding" Value="16,0" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Foreground" Value="#1E293B" />
                                            <Setter Property="FontSize" Value="13" />
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Rating column with stars -->
                                <DataGridTemplateColumn Header="Rating" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                                                <Border Background="#FFF7ED" CornerRadius="4" Padding="8,4">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="⭐" FontSize="12" />
                                                        <TextBlock Text="{Binding Rating}"
                                                            FontSize="13" FontWeight="Bold"
                                                            Foreground="#EA580C" Margin="4,0,0,0" />
                                                        <TextBlock Text="/5"
                                                            FontSize="11" Foreground="#94A3B8" VerticalAlignment="Bottom" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Bình luận" Binding="{Binding Comment}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Padding" Value="16,0" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Foreground" Value="#475569" />
                                            <Setter Property="FontSize" Value="12" />
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Ngày tạo"
                                    Binding="{Binding CreatedAt, StringFormat='dd/MM/yyyy HH:mm'}" Width="140">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Padding" Value="16,0" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Foreground" Value="#64748B" />
                                            <Setter Property="FontSize" Value="12" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Actions column -->
                                <DataGridTemplateColumn Header="Hành động" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="🗑 Xóa"
                                                Command="{Binding DataContext.DeleteReviewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Background="#FEF2F2"
                                                Foreground="#EF4444"
                                                BorderThickness="0"
                                                Padding="10,6"
                                                FontSize="12"
                                                Cursor="Hand"
                                                Margin="8,0">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#FEE2E2" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Pagination -->
                <Border Grid.Row="2"
                    Background="White"
                    CornerRadius="8"
                    Padding="16,12"
                    Margin="0,12,0,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Color="#40000000" Opacity="0.08" />
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="13" Foreground="#64748B">
                            <Run Text="Trang " />
                            <Run Text="{Binding CurrentPage}" FontWeight="SemiBold" Foreground="#1E293B" />
                            <Run Text=" / " />
                            <Run Text="{Binding TotalPages}" FontWeight="SemiBold" Foreground="#1E293B" />
                            <Run Text=" — " />
                            <Run Text="{Binding TotalItems}" FontWeight="SemiBold" Foreground="#685AFF" />
                            <Run Text=" reviews" />
                        </TextBlock>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="← Trước"
                                Command="{Binding PreviousPageCommand}"
                                Background="#F1F5F9"
                                Foreground="#475569"
                                BorderThickness="0"
                                Padding="16,8"
                                Margin="0,0,8,0"
                                FontSize="13"
                                Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.4" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#E2E8F0" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="Sau →"
                                Command="{Binding NextPageCommand}"
                                Background="#685AFF"
                                Foreground="White"
                                BorderThickness="0"
                                Padding="16,8"
                                FontSize="13"
                                Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.4" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#5649E0" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- RIGHT: Review Detail Panel -->
            <Border Grid.Column="1"
                Width="380"
                Background="White"
                CornerRadius="8"
                Visibility="{Binding ShowReviewDetail, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Color="#40000000" Opacity="0.1" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Detail Header -->
                    <Border Grid.Row="0"
                        Background="#685AFF"
                        CornerRadius="8,8,0,0"
                        Padding="20,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Chi tiết Review"
                                    FontSize="16" FontWeight="Bold" Foreground="White" />
                                <TextBlock Text="{Binding ReviewDetail.Id, StringFormat='ID: {0}'}"
                                    FontSize="12" Foreground="#C4B5FD" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                Content="✕"
                                Command="{Binding CloseReviewDetailCommand}"
                                Background="Transparent"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="16"
                                Cursor="Hand"
                                Width="32" Height="32">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="4">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#7C3AED" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Detail Content -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
                        <StackPanel>
                            <!-- Rating big display -->
                            <Border Background="#FFF7ED" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="⭐⭐⭐⭐⭐"
                                        FontSize="24" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding ReviewDetail.Rating, StringFormat='{}{0} / 5 sao'}"
                                        FontSize="20" FontWeight="Bold"
                                        Foreground="#EA580C"
                                        HorizontalAlignment="Center"
                                        Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- User Info -->
                            <TextBlock Text="THÔNG TIN NGƯỜI DÙNG"
                                FontSize="10" FontWeight="SemiBold"
                                Foreground="#94A3B8" Margin="0,0,0,8" />

                            <Border Background="#F8FAFC" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Tên:" FontSize="12" Foreground="#94A3B8" />
                                        <TextBlock Grid.Column="1" Text="{Binding ReviewDetail.UserName}"
                                            FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" />
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Email:" FontSize="12" Foreground="#94A3B8" />
                                        <TextBlock Grid.Column="1" Text="{Binding ReviewDetail.UserEmail}"
                                            FontSize="12" Foreground="#475569"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="User ID:" FontSize="12" Foreground="#94A3B8" />
                                        <TextBlock Grid.Column="1" Text="{Binding ReviewDetail.UserId}"
                                            FontSize="12" Foreground="#475569" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Product Info -->
                            <TextBlock Text="THÔNG TIN SẢN PHẨM"
                                FontSize="10" FontWeight="SemiBold"
                                Foreground="#94A3B8" Margin="0,0,0,8" />

                            <Border Background="#F8FAFC" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Tên SP:" FontSize="12" Foreground="#94A3B8" />
                                        <TextBlock Grid.Column="1" Text="{Binding ReviewDetail.ProductName}"
                                            FontSize="13" FontWeight="SemiBold" Foreground="#1E293B"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Product ID:" FontSize="12" Foreground="#94A3B8" />
                                        <TextBlock Grid.Column="1" Text="{Binding ReviewDetail.ProductId}"
                                            FontSize="12" Foreground="#475569" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Order Item:" FontSize="12" Foreground="#94A3B8" />
                                        <TextBlock Grid.Column="1" Text="{Binding ReviewDetail.OrderItemId}"
                                            FontSize="12" Foreground="#475569" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Comment -->
                            <TextBlock Text="BÌNH LUẬN"
                                FontSize="10" FontWeight="SemiBold"
                                Foreground="#94A3B8" Margin="0,0,0,8" />

                            <Border Background="#F8FAFC" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                                <TextBlock Text="{Binding ReviewDetail.Comment}"
                                    FontSize="13" Foreground="#1E293B"
                                    TextWrapping="Wrap"
                                    LineHeight="20" />
                            </Border>

                            <!-- Timestamps -->
                            <TextBlock Text="THỜI GIAN"
                                FontSize="10" FontWeight="SemiBold"
                                Foreground="#94A3B8" Margin="0,0,0,8" />

                            <Border Background="#F8FAFC" CornerRadius="8" Padding="14" Margin="0,0,0,0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Tạo lúc:" FontSize="12" Foreground="#94A3B8" />
                                        <TextBlock Grid.Column="1"
                                            Text="{Binding ReviewDetail.CreatedAt, StringFormat='dd/MM/yyyy HH:mm'}"
                                            FontSize="12" Foreground="#475569" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Cập nhật:" FontSize="12" Foreground="#94A3B8" />
                                        <TextBlock Grid.Column="1"
                                            Text="{Binding ReviewDetail.UpdatedAt, StringFormat='dd/MM/yyyy HH:mm'}"
                                            FontSize="12" Foreground="#475569" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Delete Button -->
                    <Border Grid.Row="2" Padding="20,12" BorderBrush="#F1F5F9" BorderThickness="0,1,0,0">
                        <Button Content="🗑️ Xóa Review này"
                            Command="{Binding DeleteReviewCommand}"
                            Background="#EF4444"
                            Foreground="White"
                            BorderThickness="0"
                            Padding="0,12"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            HorizontalAlignment="Stretch">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#DC2626" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
